{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Extracted Field",
  "type": "object",
  "properties": {
    "text": { "type": "string" },
    "value": { "type": ["string", "number", "null"] },
    "bbox": { 
      "type": "array", 
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["text", "bbox", "confidence"]
}
